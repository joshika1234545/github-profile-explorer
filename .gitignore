:root {
  color-scheme: dark;
  --bg: #0b1020;
  --bg-elevated: rgba(15, 23, 42, 0.8);
  --card: #111827;
  --card-soft: #1f2937;
  --fg: #e5e7eb;
  --muted: #94a3b8;
  --border: rgba(148, 163, 184, 0.25);
  --primary: #8b5cf6;
  --success: #22c55e;
  --warning: #f59e0b;
  --shadow: 0 18px 50px rgba(0, 0, 0, 0.28);
}

:root[data-theme='light'] {
  color-scheme: light;
  --bg: #f8fafc;
  --bg-elevated: rgba(255, 255, 255, 0.85);
  --card: #ffffff;
  --card-soft: #f1f5f9;
  --fg: #0f172a;
  --muted: #475569;
  --border: rgba(15, 23, 42, 0.12);
  --primary: #7c3aed;
  --success: #16a34a;
  --warning: #d97706;
  --shadow: 0 14px 30px rgba(15, 23, 42, 0.08);
}

* {
  box-sizing: border-box;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  min-height: 100vh;
  background: var(--bg);
  color: var(--fg);
  font-family: Inter, 'Segoe UI', sans-serif;
}

body {
  background:
    radial-gradient(circle at top, rgba(139, 92, 246, 0.18), transparent 30%),
    var(--bg);
}

a {
  color: var(--primary);
  text-decoration: none;
}

button, input, select {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  max-width: 1300px;
  margin: 0 auto;
  padding: 24px 18px 60px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding-bottom: 20px;
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-badge {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: linear-gradient(135deg, var(--primary), #3b82f6);
  color: white;
  font-weight: 700;
}

.eyebrow {
  margin: 0 0 4px;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.14em;
  font-size: 10px;
}

h1, h2, h3, h4, p {
  margin: 0;
}

h1 {
  font-size: clamp(1.5rem, 2vw, 2.3rem);
}

.toolbar {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.search-form {
  display: flex;
  align-items: center;
  border: 1px solid var(--border);
  border-radius: 12px;
  overflow: hidden;
  background: var(--bg-elevated);
  box-shadow: var(--shadow);
}

.search-form input,
.browser-controls input,
.browser-controls select,
.token-box input {
  border: 1px solid var(--border);
  background: transparent;
  color: var(--fg);
  border-radius: 10px;
  padding: 0.8rem 0.9rem;
}

.search-form input {
  min-width: min(44vw, 360px);
  border: none;
  background: transparent;
  color: var(--fg);
}

.search-form button,
.theme-toggle,
.repo-card button,
.drawer-header button {
  border: none;
  border-radius: 10px;
  background: linear-gradient(135deg, var(--primary), #2563eb);
  color: white;
  padding: 0.8rem 1rem;
  font-weight: 600;
}

.theme-toggle {
  background: var(--card-soft);
  color: var(--fg);
  border: 1px solid var(--border);
}

.page-content {
  display: grid;
  gap: 20px;
}

.quick-tries {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.quick-pill {
  border: 1px solid var(--border);
  background: var(--bg-elevated);
  color: var(--fg);
  border-radius: 999px;
  padding: 0.5rem 0.9rem;
}

.token-box {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  background: var(--bg-elevated);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 14px 16px;
}

.token-box label {
  font-weight: 600;
}

.token-box input {
  min-width: min(44vw, 300px);
}

.notice {
  border-radius: 12px;
  padding: 1rem 1.2rem;
  border: 1px solid transparent;
}

.notice.error {
  background: rgba(239, 68, 68, 0.12);
  border-color: rgba(239, 68, 68, 0.35);
  color: #fca5a5;
}

.card {
  background: var(--bg-elevated);
  border: 1px solid var(--border);
  border-radius: 20px;
  box-shadow: var(--shadow);
}

.profile-header {
  display: flex;
  gap: 18px;
  padding: 20px;
  align-items: center;
}

.avatar {
  width: 120px;
  height: 120px;
  border-radius: 50%;
  border: 3px solid rgba(139, 92, 246, 0.4);
  object-fit: cover;
}

.profile-copy {
  display: grid;
  gap: 10px;
  width: 100%;
}

.profile-name-row {
  display: flex;
  align-items: baseline;
  gap: 10px;
  flex-wrap: wrap;
}

.username {
  color: var(--muted);
}

.bio {
  color: var(--muted);
  line-height: 1.5;
}

.meta-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 8px 16px;
  color: var(--muted);
}

.mini-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  color: var(--muted);
}

.mini-stats strong {
  color: var(--fg);
}

.stats-grid {
  display: grid;
  gap: 16px;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
}

.stat-card {
  padding: 18px 20px;
}

.stat-card p {
  color: var(--muted);
  margin-bottom: 10px;
}

.stat-card h3 {
  font-size: clamp(1.6rem, 2vw, 2.3rem);
}

.analytics-grid,
.visual-grid {
  display: grid;
  gap: 20px;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
}

.analytics-grid > .card,
.visual-grid > .card,
.browser,
.activity {
  padding: 20px;
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 18px;
}

.donut-wrap {
  display: flex;
  align-items: center;
  gap: 24px;
  flex-wrap: wrap;
}

.donut-chart {
  width: 120px;
  height: 120px;
  border-radius: 50%;
  position: relative;
  background: conic-gradient(
    #8b5cf6 0deg 140deg,
    #3b82f6 140deg 230deg,
    #22c55e 230deg 315deg,
    #f59e0b 315deg 360deg
  );
}

.donut-chart::after {
  content: '';
  position: absolute;
  inset: 24px;
  background: var(--bg);
  border-radius: 50%;
}

.legend-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 10px;
  color: var(--muted);
}

.dot {
  display: inline-block;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--primary);
  margin-right: 8px;
}

.repo-highlight-list {
  display: grid;
  gap: 12px;
  list-style: none;
  padding: 0;
  margin: 0;
}

.repo-highlight-list li {
  display: flex;
  justify-content: space-between;
  border-bottom: 1px solid var(--border);
  padding-bottom: 10px;
  gap: 8px;
}

.repo-highlight-list li strong {
  display: block;
}

.repo-highlight-list small {
  color: var(--muted);
}

.heatmap-grid {
  display: grid;
  grid-template-columns: repeat(8, minmax(0, 1fr));
  gap: 6px;
}

.heat-cell {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 6px;
  background: rgba(148, 163, 184, 0.2);
}

.level-0 { background: rgba(148, 163, 184, 0.14); }
.level-1 { background: rgba(139, 92, 246, 0.28); }
.level-2 { background: rgba(139, 92, 246, 0.45); }
.level-3 { background: rgba(139, 92, 246, 0.7); }
.level-4 { background: rgba(139, 92, 246, 1); }

.bar-chart {
  display: grid;
  gap: 14px;
}

.bar-row {
  display: grid;
  grid-template-columns: 90px 1fr 42px;
  gap: 10px;
  align-items: center;
}

.bar-track {
  position: relative;
  height: 10px;
  border-radius: 999px;
  background: rgba(148, 163, 184, 0.2);
  overflow: hidden;
}

.bar-fill {
  position: absolute;
  inset: 0 auto 0 0;
  background: linear-gradient(90deg, var(--primary), #3b82f6);
  border-radius: inherit;
}

.browser-controls {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.browser-controls input,
.browser-controls select {
  min-width: 140px;
}

.repo-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 16px;
}

.repo-card {
  border: 1px solid var(--border);
  border-radius: 16px;
  background: var(--card-soft);
  padding: 16px;
  display: grid;
  gap: 14px;
}

.repo-card-top {
  display: flex;
  justify-content: space-between;
  gap: 14px;
}

.repo-card-top h4 {
  margin-bottom: 6px;
}

.repo-card-top p {
  color: var(--muted);
  line-height: 1.45;
}

.topic-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.topic-row span {
  font-size: 12px;
  padding: 0.35rem 0.6rem;
  border-radius: 999px;
  background: rgba(148, 163, 184, 0.14);
  color: var(--muted);
}

.repo-metrics {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
  color: var(--muted);
}

.activity-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 16px;
}

.activity-list li {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--border);
}

.event-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--primary);
  margin-top: 5px;
}

.activity-list small {
  color: var(--muted);
}

.empty-state {
  padding: 1.5rem;
  color: var(--muted);
  border: 1px dashed var(--border);
  border-radius: 12px;
  text-align: center;
}

.drawer-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(2, 6, 23, 0.7);
  display: grid;
  place-items: center;
  padding: 24px;
}

.drawer {
  width: min(900px, 100%);
  max-height: 80vh;
  overflow: auto;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 20px;
  box-shadow: var(--shadow);
  padding: 24px;
}

.drawer-header {
  display: flex;
  justify-content: space-between;
  gap: 14px;
  margin-bottom: 16px;
}

.drawer-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  color: var(--muted);
  margin-bottom: 20px;
}

.readme-box {
  border: 1px solid var(--border);
  border-radius: 14px;
  background: rgba(15, 23, 42, 0.28);
  min-height: 200px;
}

.readme-box pre {
  margin: 0;
  padding: 18px;
  white-space: pre-wrap;
  word-break: break-word;
  font-family: 'SFMono-Regular', Consolas, monospace;
  color: var(--fg);
  line-height: 1.6;
}

.loading-readme {
  min-height: 200px;
  background: linear-gradient(90deg, rgba(148, 163, 184, 0.1), rgba(255,255,255,0.08), rgba(148, 163, 184, 0.1));
  background-size: 200% 100%;
  animation: shimmer 1.4s linear infinite;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.skeleton-grid {
  display: grid;
  grid-template-columns: 1.2fr 1.6fr;
  gap: 18px;
}

.skeleton {
  background: linear-gradient(90deg, rgba(148, 163, 184, 0.1), rgba(255, 255, 255, 0.14), rgba(148, 163, 184, 0.1));
  background-size: 200% 100%;
  animation: shimmer 1.4s linear infinite;
  border-radius: 18px;
  min-height: 180px;
}

.profile-skeleton {
  grid-column: 1 / 2;
  min-height: 260px;
}

.stats-skeleton {
  grid-column: 2 / 3;
  min-height: 260px;
}

.large-skeleton {
  grid-column: 1 / -1;
  min-height: 420px;
}

.list-skeleton {
  grid-column: 1 / -1;
  min-height: 300px;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

@media (max-width: 768px) {
  .topbar,
  .profile-header,
  .toolbar,
  .token-box,
  .section-title-row {
    flex-direction: column;
    align-items: stretch;
  }

  .search-form {
    width: 100%;
  }

  .search-form input {
    min-width: 0;
    width: 100%;
  }

  .profile-header {
    align-items: flex-start;
  }

  .avatar {
    width: 88px;
    height: 88px;
  }

  .browser-controls {
    width: 100%;
    display: grid;
  }
}
